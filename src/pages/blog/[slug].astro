---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description} type="article">
  <article class="pt-16 sm:pt-24 pb-8">
    <a href="/#blog" class="link text-sm text-muted hover:text-fg">← Back to home</a>
    <header class="mt-10 mb-10">
      <h1 class="font-serif text-4xl sm:text-5xl leading-tight tracking-tight">
        {post.data.title}
      </h1>
      <time datetime={post.data.date.toISOString()} class="mt-3 block text-sm text-muted tabular-nums">
        {formatDate(post.data.date)}
      </time>
    </header>
    <div class="prose prose-stone dark:prose-invert max-w-none prose-headings:font-serif prose-headings:font-normal prose-a:text-accent prose-a:underline-offset-4">
      <Content />
    </div>
  </article>
</Layout>
