---
import { getPublishedPosts, formatDate } from '../lib/blog';

const posts = await getPublishedPosts();
---

<section id="blog" class="py-12">
  <h2 class="section-label">Blog</h2>
  {posts.length === 0 ? (
    <p class="text-muted">First post coming soon.</p>
  ) : (
    <ul class="-mx-3">
      {posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.id}`}
            class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-6 gap-y-1 rounded-md px-3 py-3 transition-colors hover:bg-line/50"
          >
            <span class="font-medium group-hover:text-accent transition-colors">
              {post.data.title}
            </span>
            <time datetime={post.data.date.toISOString()} class="text-sm text-muted tabular-nums shrink-0">
              {formatDate(post.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>
