---
import { siteConfig } from '../config';

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{hasExperience && (
  <section id="experience" class="py-24 bg-zinc-50">
    <div class="max-w-5xl mx-auto px-6">
      <div class="lg:grid lg:grid-cols-12 lg:gap-16">
        <!-- Section label -->
        <div class="col-span-3 mb-10 lg:mb-0">
          <div class="lg:sticky lg:top-28">
            <span class="font-mono text-xs font-semibold tracking-widest text-blue-700 uppercase">
              Experience
            </span>
            <div class="mt-2 h-px w-8 bg-blue-700"></div>
          </div>
        </div>

        <!-- Timeline -->
        <div class="col-span-9">
          <div class="relative">
            {siteConfig.experience.map((exp, index) => (
              <div class="relative pl-8 pb-12 last:pb-0">
                <!-- Timeline dot -->
                <div class="absolute left-0 top-1.5 w-3 h-3 rounded-full border-2 border-blue-700 bg-white"></div>

                <!-- Connecting line -->
                {index < siteConfig.experience.length - 1 && (
                  <div class="absolute left-[5px] top-4 bottom-0 w-px bg-zinc-200"></div>
                )}

                <!-- Card -->
                <div class="bg-white border border-zinc-200 rounded-lg p-6 hover:border-blue-200 hover:shadow-sm transition-all duration-200">
                  <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
                    <h3 class="font-mono font-semibold text-zinc-900 text-base">
                      {exp.title}
                    </h3>
                    <span class="font-mono text-xs text-blue-700 font-medium shrink-0">
                      {exp.dateRange}
                    </span>
                  </div>
                  <p class="font-mono text-sm text-zinc-500 mb-4">
                    {exp.companyUrl ? (
                      <a
                        href={exp.companyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-blue-700 transition-colors"
                      >
                        {exp.company}
                      </a>
                    ) : (
                      exp.company
                    )}
                  </p>
                  {exp.bullets && exp.bullets.length > 0 && (
                    <ul class="space-y-2">
                      {exp.bullets.map(bullet => (
                        <li class="flex gap-3 font-mono text-sm text-zinc-600">
                          <span class="text-blue-700 mt-0.5 shrink-0">→</span>
                          <span>{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}
