---
import { siteConfig } from '../config';

const hasFunFacts = siteConfig.funFacts && siteConfig.funFacts.length > 0;
---

{hasFunFacts && (
  <section id="fun-facts" class="py-24 bg-zinc-50">
    <div class="max-w-5xl mx-auto px-6">
      <div class="lg:grid lg:grid-cols-12 lg:gap-16">
        <!-- Section label -->
        <div class="col-span-3 mb-10 lg:mb-0">
          <div class="lg:sticky lg:top-28">
            <span class="font-mono text-xs font-semibold tracking-widest text-blue-700 uppercase">
              Fun Facts
            </span>
            <div class="mt-2 h-px w-8 bg-blue-700"></div>
            <p class="font-mono text-xs text-zinc-500 mt-4 leading-relaxed">
              Tap a card to flip it.
            </p>
          </div>
        </div>

        <!-- Flip cards -->
        <div class="col-span-9">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {siteConfig.funFacts.map(fact => (
              <button
                class="fact-card font-mono text-left w-full"
                type="button"
                aria-label={fact.label}
              >
                <div class="card-inner rounded-lg border border-zinc-200 bg-white shadow-sm">
                  <!-- Front -->
                  <div class="card-face card-front rounded-lg p-6">
                    <p class="text-xs font-semibold tracking-widest text-blue-700 uppercase mb-3">
                      {fact.label}
                    </p>
                    <p class="text-zinc-500 text-sm leading-relaxed">{fact.prompt}</p>
                  </div>
                  <!-- Back -->
                  <div
                    class="card-face card-back rounded-lg p-6"
                    style={fact.image ? `background-image: url('${fact.image}'); background-size: cover; background-position: center;` : ''}
                  >
                    <div class="card-back-overlay rounded-lg"></div>
                    <div class="relative z-10">
                      <p class="text-xs font-semibold tracking-widest uppercase mb-3"
                        style={fact.image ? 'color: #c7d2fe;' : 'color: #1d4ed8;'}>
                        {fact.label}
                      </p>
                      {fact.answerUrl ? (
                        <p class="text-sm leading-relaxed" style={fact.image ? 'color: #fff;' : 'color: #18181b;'}>
                          <a
                            href={fact.answerUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline underline-offset-4"
                            style={fact.image ? 'color: #fff; text-decoration-color: rgba(255,255,255,0.5);' : ''}
                            onclick="event.stopPropagation()"
                          >
                            {fact.answer}
                          </a>
                        </p>
                      ) : (
                        <p class="text-sm leading-relaxed" style={fact.image ? 'color: #fff;' : 'color: #18181b;'}>
                          {fact.answer}
                        </p>
                      )}
                    </div>
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .fact-card {
    perspective: 1000px;
    height: 180px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s ease, box-shadow 0.2s ease;
    transform-style: preserve-3d;
  }

  .fact-card:hover .card-inner {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .fact-card.flipped .card-inner {
    transform: rotateY(180deg);
  }

  .card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .card-front {
    background: linear-gradient(135deg, #eff6ff, #ffffff);
  }

  .card-back {
    transform: rotateY(180deg);
  }

  .card-back-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.5), rgba(0,0,0,0.75));
    z-index: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.fact-card');
    cards.forEach(card => {
      card.addEventListener('click', () => {
        card.classList.toggle('flipped');
      });
      card.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          e.preventDefault();
          card.classList.toggle('flipped');
        }
      });
    });
  });
</script>
