---
import '../styles/global.css';
---

<div class="page">
	<header class="site-header">
		<div class="container nav">
			<nav class="nav-links" aria-label="Primary">
				<a href="#home">Home</a>
				<a href="#experiences">Experiences</a>
				<a href="#projects">Projects</a>
			</nav>
		</div>
	</header>

	<main>
		<!-- Full-screen hero section -->
		<section id="home" class="hero">
			<div class="hero-content">
				<div class="profile-image">
					<img src="/profile.jpg" alt="Thomas Lee" />
				</div>
				<h1>Thomas Lee</h1>
				<p class="intro">Building clean, thoughtful experiences for the web.</p>
				<div class="social-links">
					<a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
						</svg>
					</a>
					<a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
							<rect x="2" y="9" width="4" height="12"></rect>
							<circle cx="4" cy="4" r="2"></circle>
						</svg>
					</a>
					<a href="mailto:your.email@example.com" aria-label="Email" class="social-link">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
					</a>
				</div>
			</div>
			<a href="#experiences" class="scroll-indicator" aria-label="Scroll to experiences">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M12 5v14M19 12l-7 7-7-7"/>
				</svg>
			</a>
		</section>

		<!-- Experiences section -->
		<section id="experiences" class="section experiences-section">
			<div class="container">
				<div class="section-header">
					<h2>Experiences</h2>
					<p>Internships and roles that shaped my journey.</p>
				</div>
				<div class="experience-list">
					<article class="experience-card">
						<div class="exp-meta">Summer 2025</div>
						<h3>Software Engineering Intern</h3>
						<p class="exp-company">Company Name</p>
						<p>
							Developed full-stack features and contributed to core product improvements, 
							working with React, Node.js, and PostgreSQL.
						</p>
					</article>
					<article class="experience-card">
						<div class="exp-meta">Fall 2024</div>
						<h3>Product Design Intern</h3>
						<p class="exp-company">Startup Name</p>
						<p>
							Redesigned onboarding flow and created design system components, 
							improving user activation by 40%.
						</p>
					</article>
					<article class="experience-card">
						<div class="exp-meta">Summer 2024</div>
						<h3>Front-End Developer Intern</h3>
						<p class="exp-company">Tech Company</p>
						<p>
							Built responsive marketing pages and interactive components 
							with a focus on performance and accessibility.
						</p>
					</article>
				</div>
			</div>
		</section>

		<!-- Projects section -->
		<section id="projects" class="section projects-section">
			<div class="container">
				<div class="section-header">
					<h2>Projects</h2>
					<p>Some things I've built and shared on GitHub.</p>
				</div>
				<div class="project-grid">
					<a href="https://github.com/yourusername/project-1" target="_blank" rel="noopener noreferrer" class="project-card">
						<div class="project-header">
							<h3>Project Name</h3>
							<svg class="github-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
							</svg>
						</div>
						<p class="project-description">A brief description of what this project does and the technologies used.</p>
						<div class="project-tags">
							<span class="tag">React</span>
							<span class="tag">TypeScript</span>
							<span class="tag">Node.js</span>
						</div>
					</a>

					<a href="https://github.com/yourusername/project-2" target="_blank" rel="noopener noreferrer" class="project-card">
						<div class="project-header">
							<h3>Another Project</h3>
							<svg class="github-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
							</svg>
						</div>
						<p class="project-description">Another cool project with interesting features and technologies.</p>
						<div class="project-tags">
							<span class="tag">Python</span>
							<span class="tag">FastAPI</span>
							<span class="tag">PostgreSQL</span>
						</div>
					</a>

					<a href="https://github.com/yourusername/project-3" target="_blank" rel="noopener noreferrer" class="project-card">
						<div class="project-header">
							<h3>Third Project</h3>
							<svg class="github-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
							</svg>
						</div>
						<p class="project-description">A creative solution to an interesting problem using modern tools.</p>
						<div class="project-tags">
							<span class="tag">Vue.js</span>
							<span class="tag">Tailwind</span>
							<span class="tag">Firebase</span>
						</div>
					</a>
				</div>
			</div>
		</section>
	</main>
</div>

<style>
	.page {
		min-height: 100vh;
		color: rgb(var(--fg));
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
		background: rgb(var(--bg) / 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgb(var(--border));
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem 0;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 2rem;
		font-size: 0.95rem;
	}

	.nav-links a {
		color: rgb(var(--muted));
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.nav-links a:hover {
		color: rgb(var(--accent));
	}

	/* Full-screen hero section */
	.hero {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2rem 1.5rem;
		position: relative;
	}

	.hero-content {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		max-width: 48rem;
		margin: 0 auto;
	}

	.profile-image {
		width: 180px;
		height: 180px;
		border-radius: 50%;
		overflow: hidden;
		border: 3px solid rgb(255 255 255);
		box-shadow: 
			0 20px 40px rgb(20 20 20 / 0.15),
			0 0 0 1px rgb(var(--border));
		background: linear-gradient(135deg, rgb(var(--accent) / 0.1), rgb(var(--accent-warm) / 0.1));
	}

	.profile-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.hero-content h1 {
		font-size: clamp(3rem, 6vw, 4.5rem);
		line-height: 1.1;
		margin: 0;
		font-weight: 600;
		letter-spacing: -0.025em;
	}

	.intro {
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		color: rgb(var(--muted));
		margin: 0;
		max-width: 36rem;
		line-height: 1.5;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 0.5rem;
	}

	.social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.9);
		border: 1px solid rgb(var(--border));
		color: rgb(var(--muted));
		transition: all 0.3s ease;
		box-shadow: 0 4px 12px rgb(20 20 20 / 0.06);
	}

	.social-link:hover {
		background: rgb(var(--accent));
		border-color: rgb(var(--accent));
		color: white;
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgb(var(--accent) / 0.3);
	}

	.social-link svg {
		width: 22px;
		height: 22px;
	}

	.scroll-indicator {
		position: absolute;
		bottom: 3rem;
		left: 50%;
		transform: translateX(-50%);
		color: rgb(var(--muted));
		transition: all 0.3s ease;
		animation: bounce 2s infinite;
	}

	.scroll-indicator:hover {
		color: rgb(var(--fg));
		transform: translateX(-50%) translateY(4px);
	}

	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% {
			transform: translateX(-50%) translateY(0);
		}
		40% {
			transform: translateX(-50%) translateY(-8px);
		}
		60% {
			transform: translateX(-50%) translateY(-4px);
		}
	}

	/* Experiences section */
	.section {
		padding: 5rem 0;
	}

	.experiences-section {
		background: rgb(255 255 255 / 0.5);
		border-top: 1px solid rgb(var(--border));
	}

	.section-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.section-header h2 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		margin: 0 0 0.75rem;
	}

	.section-header p {
		color: rgb(var(--muted));
		font-size: 1.1rem;
		margin: 0;
	}

	.experience-list {
		display: grid;
		gap: 1.5rem;
		max-width: 56rem;
		margin: 0 auto;
	}

	.experience-card {
		padding: 2rem;
		border-radius: var(--radius-lg);
		border: 1px solid rgb(var(--border));
		background: rgb(255 255 255 / 0.9);
		display: grid;
		gap: 0.75rem;
		transition: all 0.3s ease;
		box-shadow: 0 4px 12px rgb(20 20 20 / 0.04);
	}

	.experience-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 28px rgb(20 20 20 / 0.12);
		border-color: rgb(var(--accent) / 0.3);
	}

	.experience-card h3 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 600;
		color: rgb(var(--fg));
	}

	.exp-meta {
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--accent));
		font-weight: 600;
	}

	.exp-company {
		margin: 0;
		font-size: 1rem;
		color: rgb(var(--muted));
		font-weight: 500;
	}

	.experience-card p:last-child {
		margin: 0;
		line-height: 1.65;
		color: rgb(var(--muted));
	}

	/* Projects section */
	.projects-section {
		padding: 5rem 0;
		background: rgb(var(--bg));
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5rem;
		max-width: 72rem;
		margin: 0 auto;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem;
		border-radius: var(--radius-lg);
		border: 1px solid rgb(var(--border));
		background: rgb(255 255 255 / 0.9);
		transition: all 0.3s ease;
		box-shadow: 0 4px 12px rgb(20 20 20 / 0.04);
		text-decoration: none;
		color: inherit;
	}

	.project-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 32px rgb(20 20 20 / 0.12);
		border-color: rgb(var(--accent) / 0.5);
	}

	.project-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
	}

	.project-card h3 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 600;
		color: rgb(var(--fg));
	}

	.github-icon {
		flex-shrink: 0;
		color: rgb(var(--muted));
		transition: color 0.3s ease;
	}

	.project-card:hover .github-icon {
		color: rgb(var(--accent));
	}

	.project-description {
		margin: 0;
		line-height: 1.65;
		color: rgb(var(--muted));
		flex-grow: 1;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		background: rgb(var(--accent) / 0.1);
		color: rgb(var(--accent));
		font-size: 0.8rem;
		font-weight: 500;
		border: 1px solid rgb(var(--accent) / 0.2);
	}

	@media (max-width: 640px) {
		.nav {
			padding: 0.75rem 0;
		}

		.nav-links {
			font-size: 0.9rem;
			gap: 1.25rem;
		}

		.hero {
			padding: 1.5rem 1rem;
		}

		.profile-image {
			width: 140px;
			height: 140px;
		}

		.section {
			padding: 3.5rem 0;
		}

		.experience-card {
			padding: 1.5rem;
		}

		.project-grid {
			grid-template-columns: 1fr;
		}

		.project-card {
			padding: 1.5rem;
		}

		.scroll-indicator {
			bottom: 2rem;
		}
	}
</style>
