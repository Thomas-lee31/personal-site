---
import '../styles/global.css';
---

<div class="page">
	<header class="site-header">
		<div class="container nav">
			<a class="brand" href="#home">Thomas Lee</a>
			<nav class="nav-links" aria-label="Primary">
				<a href="#home">Home</a>
				<a href="#experiences">Experiences</a>
				<a href="#projects">Projects</a>
				<a href="#contact">Contact</a>
			</nav>
			<a class="nav-button" href="#contact">Let's talk</a>
		</div>
	</header>

	<main>
		<section id="home" class="section hero">
			<div class="container hero-grid">
				<div class="hero-content">
					<p class="eyebrow">Product design + front-end</p>
					<h1>Designing calm, clear experiences for the web.</h1>
					<p class="lead">
						I build clean interfaces and thoughtful interactions with a focus on clarity,
						speed, and craft. I care about the details that make software feel effortless.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="#projects">View projects</a>
						<a class="button ghost" href="#contact">Get in touch</a>
					</div>
				</div>
				<div class="hero-panel">
					<div class="panel-card">
						<p class="panel-title">Focus</p>
						<ul class="panel-list">
							<li>Product design systems</li>
							<li>Interface engineering</li>
							<li>Brand and web presence</li>
						</ul>
					</div>
					<div class="panel-card panel-accent">
						<p class="panel-title">Availability</p>
						<p class="panel-body">
							Open to new roles and collaborations. Based on project fit and timeline.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section id="experiences" class="section section-surface">
			<div class="container">
				<div class="section-header">
					<div>
						<h2>Experiences</h2>
						<p>Recent roles that shaped my approach to product and craft.</p>
					</div>
				</div>
				<div class="experience-list">
					<article class="experience-card">
						<div class="exp-meta">2022 - Present</div>
						<h3>Senior Product Designer · Company Name</h3>
						<p>
							Led end-to-end design for a flagship platform, aligning teams around a cohesive
							system and measurable outcomes.
						</p>
					</article>
					<article class="experience-card">
						<div class="exp-meta">2020 - 2022</div>
						<h3>Product Designer · Company Name</h3>
						<p>
							Shipped new onboarding and pricing experiences, improving activation and
							long-term retention.
						</p>
					</article>
					<article class="experience-card">
						<div class="exp-meta">2018 - 2020</div>
						<h3>Front-end Designer · Studio Name</h3>
						<p>
							Delivered responsive brand sites and product marketing pages with a focus on
							performance and clarity.
						</p>
					</article>
				</div>
			</div>
		</section>

		<section id="projects" class="section">
			<div class="container">
				<div class="section-header">
					<div>
						<h2>Projects</h2>
						<p>Selected work that blends strategy, design, and engineering.</p>
					</div>
				</div>
				<div class="project-grid">
					<article class="project-card">
						<p class="project-tag">Product Platform</p>
						<h3>Project Name</h3>
						<p>Redesigned a multi-tenant dashboard to surface critical insights faster.</p>
					</article>
					<article class="project-card">
						<p class="project-tag">Design System</p>
						<h3>Project Name</h3>
						<p>Built a component library that sped up delivery and improved consistency.</p>
					</article>
					<article class="project-card">
						<p class="project-tag">Personal Site</p>
						<h3>Project Name</h3>
						<p>Crafted a clean, editorial portfolio with thoughtful motion and typography.</p>
					</article>
				</div>
			</div>
		</section>

		<section id="contact" class="section">
			<div class="container">
				<div class="contact-card">
					<div>
						<h2>Contact</h2>
						<p>Want to build something clean and useful? Reach out.</p>
					</div>
					<div class="contact-actions">
						<a class="button light" href="mailto:hello@yourname.com">hello@yourname.com</a>
						<span class="contact-note">Add your email and socials to personalize this.</span>
					</div>
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="container">© 2026 Thomas Lee. All Rights Reserved</div>
	</footer>
</div>

<style>
	.page {
		min-height: 100vh;
		color: rgb(var(--fg));
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgb(var(--bg) / 0.75);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgb(var(--border));
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1rem 0;
	}

	.brand {
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: -0.01em;
		color: rgb(var(--fg));
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-size: 0.95rem;
	}

	.nav-links a {
		color: rgb(var(--muted));
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.nav-links a:hover {
		color: rgb(var(--fg));
	}

	.nav-button {
		padding: 0.55rem 1.2rem;
		border-radius: 999px;
		background: rgb(var(--fg));
		color: rgb(var(--bg));
		font-size: 0.9rem;
		font-weight: 500;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		box-shadow: 0 12px 24px rgb(20 20 20 / 0.15);
	}

	.nav-button:hover {
		transform: translateY(-1px);
	}

	.section {
		padding: 5.5rem 0;
		scroll-margin-top: 90px;
	}

	.section-surface {
		background: rgb(255 255 255 / 0.7);
		border-top: 1px solid rgb(var(--border));
		border-bottom: 1px solid rgb(var(--border));
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.section-header p {
		max-width: 32rem;
	}

	.hero {
		padding-top: 6.5rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		gap: 2.5rem;
		align-items: center;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.24em;
		font-size: 0.72rem;
		color: rgb(var(--muted));
		margin: 0 0 1rem;
	}

	.hero-content h1 {
		font-size: clamp(2.6rem, 5vw, 3.8rem);
		line-height: 1.05;
		margin: 0 0 1rem;
	}

	.lead {
		font-size: 1.08rem;
		max-width: 34rem;
		margin: 0 0 1.6rem;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 1.6rem;
		border-radius: 999px;
		border: 1px solid rgb(var(--border));
		font-weight: 500;
		background: rgb(255 255 255 / 0.7);
		color: rgb(var(--fg));
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}

	.button:hover {
		transform: translateY(-1px);
	}

	.button.primary {
		background: rgb(var(--accent));
		color: rgb(255 255 255);
		border-color: transparent;
		box-shadow: 0 14px 30px rgb(var(--accent) / 0.3);
	}

	.button.ghost {
		background: rgb(255 255 255 / 0.6);
	}

	.button.light {
		background: rgb(255 255 255);
		color: rgb(20 20 20);
		border-color: transparent;
	}

	.hero-panel {
		display: grid;
		gap: 1rem;
	}

	.panel-card {
		padding: 1.25rem;
		border-radius: var(--radius-lg);
		background: rgb(255 255 255 / 0.85);
		border: 1px solid rgb(var(--border));
		box-shadow: 0 24px 40px rgb(20 20 20 / 0.08);
	}

	.panel-accent {
		background: linear-gradient(
			140deg,
			rgb(255 255 255 / 0.95),
			rgb(var(--accent) / 0.08)
		);
		border-color: rgb(var(--accent) / 0.3);
	}

	.panel-title {
		margin: 0 0 0.6rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: rgb(var(--muted));
	}

	.panel-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
		font-weight: 500;
	}

	.panel-body {
		margin: 0;
		color: rgb(var(--fg));
	}

	.experience-list {
		display: grid;
		gap: 1rem;
	}

	.experience-card {
		padding: 1.5rem;
		border-radius: var(--radius-lg);
		border: 1px solid rgb(var(--border));
		background: rgb(255 255 255 / 0.8);
		display: grid;
		gap: 0.5rem;
	}

	.experience-card h3 {
		margin: 0;
		font-size: 1.15rem;
	}

	.exp-meta {
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgb(var(--muted));
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.project-card {
		padding: 1.5rem;
		border-radius: var(--radius-lg);
		border: 1px solid rgb(var(--border));
		background: rgb(255 255 255 / 0.85);
		display: grid;
		gap: 0.75rem;
	}

	.project-card h3 {
		margin: 0;
		font-size: 1.2rem;
	}

	.project-tag {
		margin: 0;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: rgb(var(--muted));
	}

	.contact-card {
		position: relative;
		padding: 2rem;
		border-radius: var(--radius-lg);
		background: rgb(var(--fg));
		color: rgb(var(--bg));
		overflow: hidden;
		display: grid;
		gap: 1.25rem;
	}

	.contact-card::after {
		content: "";
		position: absolute;
		top: -40%;
		right: -10%;
		width: 260px;
		height: 260px;
		background: radial-gradient(
			circle,
			rgb(var(--accent-warm) / 0.5),
			transparent 70%
		);
		opacity: 0.7;
	}

	.contact-card h2 {
		margin: 0 0 0.5rem;
		color: rgb(var(--bg));
	}

	.contact-card p {
		margin: 0;
		color: rgb(255 255 255 / 0.75);
		max-width: 32rem;
	}

	.contact-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		position: relative;
		z-index: 1;
	}

	.contact-note {
		font-size: 0.85rem;
		color: rgb(255 255 255 / 0.65);
	}

	.site-footer {
		padding: 2rem 0 3rem;
		color: rgb(var(--muted));
		font-size: 0.85rem;
		text-align: center;
	}

	@media (max-width: 900px) {
		.nav {
			flex-wrap: wrap;
		}

		.nav-links {
			width: 100%;
			justify-content: space-between;
			flex-wrap: wrap;
		}

		.nav-button {
			display: none;
		}

		.section-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.hero-grid {
			grid-template-columns: 1fr;
		}

		.project-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.section {
			padding: 3.5rem 0;
		}

		.nav {
			padding: 0.75rem 0;
		}

		.hero {
			padding-top: 4.5rem;
		}

		.hero-actions,
		.contact-actions {
			width: 100%;
		}

		.button {
			width: 100%;
		}

		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
