---
import { siteConfig } from '../config';
---

<section id="about" class="relative pt-20 sm:pt-28 pb-12">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-10 -left-24 h-72 w-72 rounded-full bg-accent/15 blur-3xl"
  ></div>

  <div class="relative">
    <h1 class="fade-up font-serif text-5xl sm:text-6xl leading-none tracking-tight">
      {siteConfig.name}
    </h1>
    <p class="fade-up [animation-delay:80ms] mt-4 font-serif italic text-xl sm:text-2xl text-muted">
      {siteConfig.tagline}
    </p>
    <div class="fade-up [animation-delay:160ms] mt-10 space-y-4 leading-relaxed">
      {siteConfig.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="fade-up [animation-delay:240ms] mt-8 text-muted">
      Always happy to chat. Reach me by
      <a href={`mailto:${siteConfig.email}`} class="link text-accent">email</a>
      or on
      <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="link text-accent">LinkedIn</a>.
    </p>
  </div>
</section>
