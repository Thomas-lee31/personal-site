---
import { siteConfig } from '../config';
---

<footer class="w-full max-w-2xl mx-auto px-6 pt-16 pb-12">
  <div class="border-t border-line pt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-sm">
    <div class="flex items-center gap-6">
      <a href={`mailto:${siteConfig.email}`} class="link text-fg">
        Email
      </a>
      <a
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="link text-fg"
      >
        LinkedIn
      </a>
    </div>
    <p class="text-muted">
      © {new Date().getFullYear()} {siteConfig.name}
    </p>
  </div>
</footer>
